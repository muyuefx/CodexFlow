{
  "name": "codex-flow", "version": "1.0.0", "private": true, "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4", "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0", "@uiw/react-codemirror": "^4.25.6",
    "@xyflow/react": "^12.11.6", "chokidar": "^4.0.3", "diff": "^8.0.2",
    "fastify": "^5.6.2", "lucide-react": "^0.577.0", "react": "^19.2.0",
    "react-dom": "^19.2.0", "react-markdown": "^10.1.0", "remark-gfm": "^4.0.1", "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2", "@types/node": "^24.0.0", "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0", "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.27.0", "tsx": "^4.21.0", "typescript": "^5.9.3", "vite": "^7.2.0"
  }
}
